[Unit]
Description=Aervyx staging GitHub webhook listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/aervyx-staging/repo
EnvironmentFile=/etc/default/aervyx-staging-webhook
ExecStart=/usr/bin/python3 /srv/aervyx-staging/repo/deploy/staging/webhook_listener.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
