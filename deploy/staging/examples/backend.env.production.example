APP_NAME=Aervyx API
APP_ENV=production
APP_SECRET_KEY=change-me
APP_PUBLIC_URL=https://staging.aervyx.net
API_PUBLIC_URL=https://api-staging.aervyx.net
DATABASE_URL=postgresql+psycopg://flightcomp:change-me@db:5432/flightcomp
UPLOAD_ROOT=/app/storage/uploads
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["https://staging.aervyx.net","https://api-staging.aervyx.net"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","frontend","staging.aervyx.net","api-staging.aervyx.net"]
MESH_CHANNEL_PSK=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=
MQTT_PASSWORD=
MESH_MQTT_TOPIC_PREFIX=aervyx
