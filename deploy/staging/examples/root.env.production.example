COMPOSE_PROJECT_NAME=aervyx-staging
POSTGRES_DB=flightcomp
POSTGRES_USER=flightcomp
POSTGRES_PASSWORD=change-me
MOSQUITTO_EXTRA_CONFIG_DIR=/srv/aervyx-staging/mosquitto/conf.d
MOSQUITTO_CERT_DIR=/srv/aervyx-staging/mosquitto/certs
MOSQUITTO_SECRET_DIR=/srv/aervyx-staging/mosquitto/secrets
ACME_EMAIL=admin@aervyx.net
CAR_TLS_HTTP_BIND=0.0.0.0
CAR_TLS_HTTP_PORT=80
CAR_TLS_HTTPS_BIND=0.0.0.0
CAR_TLS_HTTPS_PORT=443
