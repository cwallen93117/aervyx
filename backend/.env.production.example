APP_NAME=Aervyx API
APP_ENV=production
# CRITICAL: Replace with a strong random value! Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app will REFUSE TO START in production with the default 'change-me' value.
APP_SECRET_KEY=change-me
APP_PUBLIC_URL=https://aervyx.net
API_PUBLIC_URL=https://api.aervyx.net
DATABASE_URL=postgresql+psycopg://flightcomp:change-me@db:5432/flightcomp
UPLOAD_ROOT=/app/storage/uploads
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=365
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=["https://aervyx.net","https://car.aervyx.net","https://api.aervyx.net"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","frontend","aervyx.net","car.aervyx.net","api.aervyx.net"]
MESH_CHANNEL_PSK=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=
MQTT_PASSWORD=
MOSQUITTO_PASSWORD_FILE=/mosquitto/secrets/passwords
MESH_MQTT_TOPIC_PREFIX=aervyx
# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin-entered integration secrets are encrypted with this key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=
# FAA NOTAMS API (optional; admin UI can configure these when INTEGRATION_SECRET_KEY is set)
FAA_NOTAM_API_ENABLED=false
FAA_NOTAM_API_BASE_URL=https://api.faa.gov
FAA_NOTAM_API_CLIENT_ID=
FAA_NOTAM_API_CLIENT_SECRET=
FAA_NOTAM_API_CLIENT_ID_HEADER=client_id
FAA_NOTAM_API_CLIENT_SECRET_HEADER=client_secret
