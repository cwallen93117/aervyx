APP_NAME=Aervyx API
APP_ENV=development
# CRITICAL: Generate a strong random secret for production.
# In dev mode an ephemeral key is auto-generated if this is left as 'change-me'.
# In production mode the app will REFUSE TO START with the default value.
APP_SECRET_KEY=change-me
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://flightcomp:flightcomp@db:5432/flightcomp
UPLOAD_ROOT=/app/storage/uploads
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","frontend","aervyx.net","api.aervyx.net"]
MESH_CHANNEL_PSK=
MQTT_HOST=mqtt
MQTT_PORT=1883
MESH_MQTT_TOPIC_PREFIX=aervyx
# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin-entered integration secrets are encrypted with this key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=
# FAA NOTAMS API (optional; admin UI can configure these when INTEGRATION_SECRET_KEY is set)
FAA_NOTAM_API_ENABLED=false
FAA_NOTAM_API_BASE_URL=https://api.faa.gov
FAA_NOTAM_API_CLIENT_ID=
FAA_NOTAM_API_CLIENT_SECRET=
FAA_NOTAM_API_CLIENT_ID_HEADER=client_id
FAA_NOTAM_API_CLIENT_SECRET_HEADER=client_secret
